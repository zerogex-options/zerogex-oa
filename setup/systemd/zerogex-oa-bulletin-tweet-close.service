[Unit]
Description=ZeroGEX Live-Bulletin post-market X post (16:05 ET)
Documentation=https://github.com/zerogex/options/zerogex-oa
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-oa

Environment="PATH=/home/ubuntu/zerogex-oa/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/ubuntu/zerogex-oa/.env

# Stages the post-market bulletin tweet for human approval.  See the
# premarket unit for the full stage → approve → post lifecycle.  This
# is the highest-signal fire of the three: closing print + the
# auction, and the day's replay clip is complete so the video
# attachment shows the full session sweep.  Flip
# BULLETIN_TWEET_AUTOPILOT=1 in the EnvironmentFile to auto-post
# without approval.
ExecStart=/home/ubuntu/zerogex-oa/venv/bin/python -m src.jobs.bulletin_tweet --mode close --stage

TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/zerogex-oa /var/lib/zerogex-oa
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-oa-bulletin-tweet-close
