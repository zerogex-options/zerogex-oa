# Sample config for the zerogex-alert@.service template dispatcher.
#
# Install location: /etc/zerogex/alert.env  (chmod 640, owner root:ubuntu)
#
# Pick ONE backend by setting ALERT_BACKEND, then fill in the matching
# secret(s) below.  Leave the rest commented out.
#
# Smoke test after install:
#   make alert-template-test
# (writes a synthetic alert to the chosen backend; defaults to stderr,
# which lands in `journalctl -u zerogex-alert@*`).

# ---------------------------------------------------------------------------
# Cooldown (applies to every backend)
#
# A failing oneshot re-fires on its own timer, and each firing dispatches. The
# ingestion freshness check runs every 10 minutes, so one stale symbol sent ~12
# emails a day until this existed. Within ALERT_MIN_INTERVAL_SEC, a repeat of
# the SAME failure is folded into the first alert and merely counted; the next
# alert to get through says how many were held.
#
# "Same" is judged from the failing journal lines with numbers flattened, so a
# ticking staleness counter still counts as one incident — but a DIFFERENT
# failure (a second symbol going dark) pages immediately rather than waiting
# out the window. Recovery notices are never suppressed and re-arm the next
# failure.
#
# Suppressed alerts are always logged: `journalctl -t zerogex-alert`.
# Set to 0 to alert on every firing (the pre-2026-09 behaviour).
# ---------------------------------------------------------------------------
#ALERT_MIN_INTERVAL_SEC=3600

# ---------------------------------------------------------------------------
# stderr — default; logs to systemd journal of the alert unit.
# ---------------------------------------------------------------------------
ALERT_BACKEND=stderr

# ---------------------------------------------------------------------------
# slack — incoming-webhook URL.  Create one at:
#   https://api.slack.com/messaging/webhooks
# ---------------------------------------------------------------------------
#ALERT_BACKEND=slack
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXXXX

# ---------------------------------------------------------------------------
# sns — AWS Simple Notification Service topic (host needs IAM permission
# `sns:Publish` on the topic; AWS CLI must be installed and configured).
# Subscribers (email / SMS / Lambda / SQS) are managed in the AWS console.
# ---------------------------------------------------------------------------
#ALERT_BACKEND=sns
#SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:zerogex-alerts

# ---------------------------------------------------------------------------
# pagerduty — Events API v2.  Use an "Events API V2" integration on a
# service in PagerDuty and copy the integration key here.  Failure events
# are sent with action=trigger and dedup_key=<unit>@<host> so duplicate
# triggers from the same unit on the same host fold into one incident.
# ---------------------------------------------------------------------------
#ALERT_BACKEND=pagerduty
#PAGERDUTY_ROUTING_KEY=R0000000000000000000000000000000

# ---------------------------------------------------------------------------
# webhook — generic POST of {unit, host, timestamp, journal_tail} JSON to
# any receiver (Datadog event API, Opsgenie, custom relay, etc.).
# ---------------------------------------------------------------------------
#ALERT_BACKEND=webhook
#WEBHOOK_URL=https://example.com/alerts/zerogex

# ---------------------------------------------------------------------------
# resend — email via https://resend.com. The alert subject is the one-line
# summary; the body includes the recent journal tail.
#
# RESEND_API_KEY and RESEND_FROM_EMAIL are read from here IF set, otherwise
# pulled automatically from the app .env (ALERT_APP_ENV, default
# /home/ubuntu/zerogex-oa/.env) — so if Resend is already configured for the
# app, you do NOT need to copy the secret here; just set the two lines below.
# Recipient defaults to the address inside RESEND_FROM_EMAIL when ALERT_EMAIL_TO
# is unset. ALERT_EMAIL_TO may be a comma-separated list for several recipients.
# ---------------------------------------------------------------------------
#ALERT_BACKEND=resend
#ALERT_EMAIL_TO=michael@zerogex.io
# Optional overrides (else taken from the app .env):
#RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
#RESEND_FROM_EMAIL=Michael at ZeroGEX <michael@zerogex.io>
#ALERT_APP_ENV=/home/ubuntu/zerogex-oa/.env
