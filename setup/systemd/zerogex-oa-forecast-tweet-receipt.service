[Unit]
Description=ZeroGEX Gamma Forecast receipt tweet (16:10 ET, ~5 min after receipt)
Documentation=https://github.com/zerogex-options/zerogex-oa
After=network-online.target postgresql.service zerogex-oa-forecast-receipt.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-oa

Environment="PATH=/home/ubuntu/zerogex-oa/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/ubuntu/zerogex-oa/.env

# Posts the 4 PM receipt tweet — range held/broken, pin hit/missed,
# regime correct/wrong.  Same env-and-flag safeguard as the morning tweet.
ExecStart=/home/ubuntu/zerogex-oa/venv/bin/python -m src.jobs.forecast_tweet --mode receipt --post

TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/zerogex-oa
# The posted-marker files live in /var/lib/zerogex-oa/forecast-tweets, which
# ProtectSystem=strict makes read-only unless it is granted here.  Without
# this the marker write fails, the guard fails OPEN by design, and
# _already_posted can never return anything — so a Persistent=true catch-up
# after downtime reposts a tweet that already went out.  StateDirectory
# rather than ReadWritePaths because it also CREATES the directory with the
# right ownership; ReadWritePaths on a path that does not exist refuses to
# start the unit.
StateDirectory=zerogex-oa
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-oa-forecast-tweet-receipt
