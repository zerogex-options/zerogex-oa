[Unit]
Description=ZeroGEX intraday cone grader (every 15m, 10:05-16:50 ET)
Documentation=https://github.com/zerogex-options/zerogex-oa
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-oa

Environment="PATH=/home/ubuntu/zerogex-oa/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/ubuntu/zerogex-oa/.env

# Finds claims whose horizon has elapsed, reads what the tape did over the
# OPEN interval (forecast_ts, target_ts], and writes the verdict once.  The
# graded_at IS NULL guard plus the immutability trigger mean a concurrent or
# repeated run is harmless rather than a double-count.
ExecStart=/home/ubuntu/zerogex-oa/venv/bin/python -m src.jobs.intraday_cone_receipt

TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/zerogex-oa
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-oa-forecast-cone-receipt
