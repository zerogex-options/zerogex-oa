[Unit]
Description=ZeroGEX per-symbol ingestion freshness check (alerts when a symbol goes dark)
Documentation=https://github.com/zerogex-options/zerogex-oa
After=network-online.target
Wants=network-online.target

# Wired to the same dispatcher as the ingestion unit itself. This check is
# the ONLY thing that notices a single dead per-symbol worker: the ingestion
# unit's own OnFailure cannot fire for it, because the parent process stays
# alive as long as one worker survives, so systemd never sees the unit fail.
OnFailure=zerogex-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-oa

# Environment
Environment="PATH=/home/ubuntu/zerogex-oa/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/ubuntu/zerogex-oa/.env

# Exits 0 when every checked symbol has a recent bar (and when none is being
# checked at all — overnight, weekends, and extended hours, where the vendor's
# own bar delivery is too discontinuous to hold to a deadline), 1 when a stale
# symbol is due to page, 2 on DB error. A nonzero exit marks the unit failed,
# which surfaces in `systemctl --failed` and fires the OnFailure hook above.
#
# INGEST_FRESHNESS_STATE_FILE makes the paging edge-triggered: a stale symbol
# alerts on the run that first sees it and then at most once an hour, the same
# contract zerogex-liveness-watch.sh uses. Without it this timer's 10-minute
# cadence would send six emails an hour for as long as the outage lasted —
# and the outage it exists to catch lasts until a human acts (the QQQ incident
# ran ~6 h, i.e. ~36 emails). While a known-stale symbol is inside its quiet
# period the unit exits 0, so `systemctl --failed` goes green even though the
# symbol is still dark; `journalctl -u zerogex-oa-ingestion-freshness` keeps
# logging it at ERROR on every run and is the live view.
ExecStart=/usr/bin/make -C /home/ubuntu/zerogex-oa ingestion-freshness-healthcheck \
    INGEST_FRESHNESS_STATE_FILE=/home/ubuntu/monitoring/ingestion-freshness.json

# A single GROUP BY over an indexed column — no excuse for it to run long.
TimeoutStartSec=120

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# /home/ubuntu/monitoring holds the edge-trigger state file above (the same
# directory the system-monitor and liveness watchdog already write to; the
# deploy pre-creates it). ReadWritePaths= overrides ProtectHome for it.
ReadWritePaths=/home/ubuntu/zerogex-oa /home/ubuntu/monitoring

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-oa-ingestion-freshness
