[Unit]
Description=ZeroGEX Options Analytics API Server
Documentation=https://github.com/zerogex-options/zerogex-oa
After=network-online.target zerogex-oa-ingestion.service
Wants=network-online.target

# Operator hook for active alerting (e.g. PagerDuty, Slack, email).
# Wired to zerogex-alert@%n.service, which takes the failed unit name
# as %i and dispatches to whatever backend is configured in
# /etc/zerogex/alert.env (slack | sns | pagerduty | webhook | stderr).
# Without alert.env the dispatcher falls back to stderr — alerts still
# land in the alert unit's own journal so the wiring is verifiable.
OnFailure=zerogex-alert@%n.service

# Restart rate limiting — 5 starts per 300s, unchanged; this is purely a move
# to the canonical section. systemd moved these to [Unit] in v229 and renamed
# StartLimitInterval -> StartLimitIntervalSec. The old [Service] spelling still
# WORKS (it is a documented backward-compat alias that writes into the same
# per-unit rate limiter, which is why `systemd-analyze verify` never flagged
# it), but it reads like a [Service] knob when it is not one. Same values, same
# behaviour, canonical spelling.
#
# The window is intentionally long relative to RestartSec=10 below, so a unit
# that dies immediately on start — a genuine crash loop from a bad deploy —
# latches instead of flapping forever. Note the flip side, which the
# ExecStartPost comment below also cares about: a failure that recurs faster
# than 5-per-300s WILL latch the unit into start-limit-hit and hold the API
# down until a human runs `systemctl reset-failed`. That is why the MemoryMax
# headroom in [Service] matters — it keeps OOM restarts, which recur minutes
# apart, from ever accumulating to this bound.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-oa
Environment="PATH=/home/ubuntu/zerogex-oa/venv/bin"
EnvironmentFile=/home/ubuntu/zerogex-oa/.env

# Execution
ExecStart=/home/ubuntu/zerogex-oa/venv/bin/uvicorn \
    src.api.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 2 \
    --log-level info
ExecReload=/bin/kill -HUP $MAINPID

# Readiness gate: don't mark the unit Active until the process answers on
# /api/health/live — a DB-FREE liveness endpoint (src/api/main.py; listed in
# security._PUBLIC_PATHS so it needs no credentials). Retries up to ~30s while
# uvicorn binds. --retry-connrefused needs curl >= 7.52 (Ubuntu 22.04 ships
# 7.81).
#
# This intentionally does NOT probe the deep, DB-touching /api/health. Gating
# startup on a DB check means a transient DB blip during a (re)start fails
# ExecStartPost; Restart=always then relaunches and StartLimitBurst latches
# the unit into start-limit-hit — turning seconds of DB trouble into a full,
# human-in-the-loop outage. Liveness must reflect only "is this process
# serving HTTP?"; deep DB health is monitored separately via /api/health.
ExecStartPost=/bin/sh -c '/usr/bin/curl --fail --silent --show-error \
    --retry 30 --retry-delay 1 --retry-connrefused --max-time 5 \
    http://127.0.0.1:8000/api/health/live > /dev/null'

# Restart policy (StartLimit* moved to [Unit], its canonical section)
Restart=always
RestartSec=10

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
SendSIGKILL=yes

# Resource limits
#
# MemoryMax is enforced against the unit's whole cgroup — the uvicorn parent
# AND both workers share this budget, it is not per-process. At 1G that gave
# each worker only ~500M, and a couple of concurrent large analytics reads
# (strike-profile-timeseries / heatmap over a wide window) were enough to trip
# the kernel OOM killer. One worker dying takes the whole unit down, systemd
# reports `Failed with result 'oom-kill'`, OnFailure= fires, and Restart=always
# brings it back ~10s later — a self-healing flap whose only visible symptom
# was a stream of alert emails.
#
# 2G budget on the m5.large (8 GiB, deploy/README.md): during the cash session
# the concurrent units are ingestion 2G + analytics 1G + signals 1G + api 2G =
# 6G, leaving ~2 GiB for the OS and nginx. backtest-worker (2G) is excluded
# because its timer fires post-close at 17:30 ET, so it never overlaps.
MemoryMax=2G
# Soft brake: past this the kernel applies reclaim pressure and throttles
# allocation instead of killing outright, which gives the allocator a chance to
# return freed arenas. The band is deliberately narrow (200M) because the box
# has no swap — a Python worker's memory is mostly anonymous, so sustained
# throttling here would stall requests rather than free much. It should only
# ever engage in the last stretch before the hard cap; idle/normal-load steady
# state sits far below it. Remove this line if reclaim stalls ever show up
# before an actual OOM.
#
# NOTE this is headroom, not a cure. A single window_units=480 strike-profile
# request still peaks in the hundreds of MB — dominated by serialising the
# finished payload, not by the query — so a burst of wide concurrent requests
# can still reach 2G. If these alerts return, the fix is to shrink that
# response (cap window_units, or stream it), not to keep raising this number.
MemoryHigh=1800M
# 2 uvicorn workers (one event loop each) → allow up to 2 cores. At 100% the two
# workers shared a single core and CFS-throttled in bursts during the cash session,
# adding event-loop scheduling delay on top of DB reads. CPUWeight below still wins
# contention against the background workers.
CPUQuota=200%
# API wins contended cycles over background workers (ingestion=100, analytics/signals=80)
CPUWeight=400

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/zerogex-oa

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-oa-api

[Install]
WantedBy=multi-user.target
