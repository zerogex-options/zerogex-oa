[Unit]
Description=ZeroGEX Options Analytics API Server
Documentation=https://github.com/zerogex-options/zerogex-oa
After=network-online.target zerogex-oa-ingestion.service
Wants=network-online.target

# Operator hook for active alerting (e.g. PagerDuty, Slack, email).
# Wired to zerogex-alert@%n.service, which takes the failed unit name
# as %i and dispatches to whatever backend is configured in
# /etc/zerogex/alert.env (slack | sns | pagerduty | webhook | stderr).
# Without alert.env the dispatcher falls back to stderr — alerts still
# land in the alert unit's own journal so the wiring is verifiable.
OnFailure=zerogex-alert@%n.service

# Restart rate limiting — 5 starts per 300s, unchanged; this is purely a move
# to the canonical section. systemd moved these to [Unit] in v229 and renamed
# StartLimitInterval -> StartLimitIntervalSec. The old [Service] spelling still
# WORKS (it is a documented backward-compat alias that writes into the same
# per-unit rate limiter, which is why `systemd-analyze verify` never flagged
# it), but it reads like a [Service] knob when it is not one. Same values, same
# behaviour, canonical spelling.
#
# The window is intentionally long relative to RestartSec=10 below, so a unit
# that dies immediately on start — a genuine crash loop from a bad deploy —
# latches instead of flapping forever. Note the flip side, which the
# ExecStartPost comment below also cares about: a failure that recurs faster
# than 5-per-300s WILL latch the unit into start-limit-hit and hold the API
# down until a human runs `systemctl reset-failed`. That is why the MemoryMax
# headroom in [Service] matters — it keeps OOM restarts, which recur minutes
# apart, from ever accumulating to this bound.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-oa
Environment="PATH=/home/ubuntu/zerogex-oa/venv/bin"
EnvironmentFile=/home/ubuntu/zerogex-oa/.env

# Execution
# --no-access-log: uvicorn's access log was the API's dominant journal
# consumer -- 239,983 lines/hour measured 2026-09-01, 42 MB/h, against a 300M
# cap shared with three other services. Only ~6,300 of those lines fell into
# any repeated shape, because every distinct URL is its own shape, which is
# exactly why a top-N view never showed it.
#
# Nothing is lost: nginx fronts this service (deploy/steps/120.nginx_api
# proxy_passes to 127.0.0.1:8000) and writes the same requests to
# /var/log/nginx/access.log, on the filesystem rather than in the journal, and
# already rotated by the nightly logs-clear. The journal keeps uvicorn's
# errors and the application's own logs, which is what a post-mortem reads.
#
# Drop this flag to get per-request lines back in the journal when debugging
# something nginx's log cannot answer.
ExecStart=/home/ubuntu/zerogex-oa/venv/bin/uvicorn \
    src.api.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 2 \
    --no-access-log \
    --log-level info
ExecReload=/bin/kill -HUP $MAINPID

# Readiness gate: don't mark the unit Active until the process answers on
# /api/health/live — a DB-FREE liveness endpoint (src/api/main.py; listed in
# security._PUBLIC_PATHS so it needs no credentials). Retries up to ~30s while
# uvicorn binds. --retry-connrefused needs curl >= 7.52 (Ubuntu 22.04 ships
# 7.81).
#
# This intentionally does NOT probe the deep, DB-touching /api/health. Gating
# startup on a DB check means a transient DB blip during a (re)start fails
# ExecStartPost; Restart=always then relaunches and StartLimitBurst latches
# the unit into start-limit-hit — turning seconds of DB trouble into a full,
# human-in-the-loop outage. Liveness must reflect only "is this process
# serving HTTP?"; deep DB health is monitored separately via /api/health.
ExecStartPost=/bin/sh -c '/usr/bin/curl --fail --silent --show-error \
    --retry 30 --retry-delay 1 --retry-connrefused --max-time 5 \
    http://127.0.0.1:8000/api/health/live > /dev/null'

# Restart policy (StartLimit* moved to [Unit], its canonical section)
Restart=always
RestartSec=10

# Process management
KillMode=mixed
KillSignal=SIGTERM
# Long enough for an in-flight request to finish and the worker to exit
# cleanly. This was 30s, which is SHORTER than the read paths' own guards --
# /api/gex/strike-profile-timeseries bounds a query at 15s and was routinely
# observed at 20s+ once pool wait is counted, so every restart under cash-session
# load hit this timeout and ended in SIGKILL (journal: "Main process exited,
# code=killed, status=9/KILL" with result 'timeout' -- note that is a STOP
# timeout, not an OOM, and the two are easy to confuse when reading the log).
#
# SIGKILL mid-query is survivable here (reads only, and asyncpg's server-side
# statement timeout cleans up the backend), but it makes every deploy look like
# a crash and gives an in-flight write no chance to unwind. 60s clears the
# slowest bounded read with headroom.
TimeoutStopSec=60
SendSIGKILL=yes

# Resource limits
#
# MemoryMax is enforced against the unit's whole cgroup — the uvicorn parent
# AND both workers share this budget, it is not per-process. At 1G that gave
# each worker only ~500M, and a couple of concurrent large analytics reads
# (strike-profile-timeseries / heatmap over a wide window) were enough to trip
# the kernel OOM killer. One worker dying takes the whole unit down, systemd
# reports `Failed with result 'oom-kill'`, OnFailure= fires, and Restart=always
# brings it back ~10s later — a self-healing flap whose only visible symptom
# was a stream of alert emails.
#
# 5G of a 15.7G box with 4G of swap. The 2G this used to be was sized when the
# box had 8 GiB; on 2026-10-27 the API's footprint measured about 3.7G and the
# box had about 10G available. The caps of everything that runs through the
# cash session: api 5G + ingestion 2G + analytics 1G + signals 1G +
# thetaterminal 1G + wall-alerts 256M = 10.25G. Raising any of them is a
# box-level decision, so read `free -m` during a session first. backtest-worker
# (2G) is excluded because its timer fires post-close at 17:30 ET, so it never
# overlaps.
MemoryMax=5G
# Never swap the API. With swap on the box, a unit at its memory limit is not
# OOM-killed: the kernel moves its memory out to disk and keeps it running. A
# Python worker touches its heap constantly, so it keeps paying disk reads to
# bring it back, and every request slows. That is how the 2G cap failed on
# 2026-10-27: the API held 1888M in RAM and 1882M in swap (all of the box's
# swap was the API's). After the MemoryHigh brake below came off, memory.events
# went from max 0 to max 12922 with oom_kill still 0, and 439 requests in the
# latest hour checked still took 5 s or more.
#
# With MemorySwapMax=0, reaching MemoryMax means an OOM kill and a ~10 s restart
# that OnFailure= reports, not a slowdown nothing reports. If that starts, cut
# what each worker holds (the per-worker read caches and the widest responses;
# one window_units=480 strike-profile request still peaks in the hundreds of
# MB) before raising the cap again.
MemorySwapMax=0
# No MemoryHigh= soft brake, on purpose. One sat at 1800M from 2026-08-17, with
# the instruction to remove it if reclaim stalls ever showed up before an actual
# OOM. They did. memory.events on 2026-10-27, since the unit started:
#
#     high 14307   sock_throttled 414255   max 0   oom_kill 0
#     memory.current 1774M   memory.peak 1821M
#
# The kernel throttled the workers at the brake (`high`), moved their memory out
# to swap, and throttled the unit's sockets (`sock_throttled`), which stalled
# every request, not only the large ones. In that day's journal /api/gex/summary
# had taken 5 s or more 15,657 times and /api/market/quote 12,859 times, and in
# one stall requests to more than a dozen endpoints, some 20 s old, all finished
# in the same second. Whenever a stall covered the liveness watchdog's 5 s
# probe, it mailed "active but not serving".

# 2 uvicorn workers (one event loop each) → allow up to 2 cores. At 100% the two
# workers shared a single core and CFS-throttled in bursts during the cash session,
# adding event-loop scheduling delay on top of DB reads. CPUWeight below still wins
# contention against the background workers.
CPUQuota=200%
# API wins contended cycles over background workers (ingestion=100, analytics/signals=80)
CPUWeight=400

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/zerogex-oa

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-oa-api

[Install]
WantedBy=multi-user.target
