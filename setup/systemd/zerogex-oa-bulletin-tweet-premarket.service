[Unit]
Description=ZeroGEX Live-Bulletin pre-market X post (09:15 ET)
Documentation=https://github.com/zerogex/options/zerogex-oa
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-oa

Environment="PATH=/home/ubuntu/zerogex-oa/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/ubuntu/zerogex-oa/.env

# Stages the pre-market bulletin tweet for human approval.  Writes the
# full draft (text + PNG + clip + manifest with state=pending) and
# calls $BULLETIN_TWEET_NOTIFY_HOOK if configured — operator then runs
# ``bin/bulletin-approve.sh premarket`` to actually POST to X.
#
# Flip to full autopilot (no approval) by setting
# ``BULLETIN_TWEET_AUTOPILOT=1`` in the EnvironmentFile — that upgrades
# --stage to --post at runtime.  Safe-by-default: without the env var,
# nothing goes out until you approve.
ExecStart=/home/ubuntu/zerogex-oa/venv/bin/python -m src.jobs.bulletin_tweet --mode premarket --stage

TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The artifact directory is the primary write target; also allow the
# job's local logs to accumulate under the working directory.
ReadWritePaths=/home/ubuntu/zerogex-oa /var/lib/zerogex-oa
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-oa-bulletin-tweet-premarket
