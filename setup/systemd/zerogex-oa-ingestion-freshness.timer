[Unit]
Description=Periodic ZeroGEX per-symbol ingestion freshness check (every 10 min)

[Timer]
# Every 10 minutes, all day. Unlike the nightly healthchecks this one is a
# LIVE detector: the failure it exists to catch (a per-symbol worker dying
# and never being restarted) costs irreplaceable market data for as long as
# it goes unnoticed — the QQQ outage it was written for ran ~6 hours into a
# session. The check itself is one indexed GROUP BY, so a 10-minute cadence
# is cheap; the tool's own staleness threshold (15 min by default) is what
# decides whether a given run alerts, not this interval.
#
# Deliberately NOT restricted to market hours in the timer: the tool decides
# what to assert per symbol per run, reporting anything it will not hold to a
# deadline (overnight, weekends, and extended hours, where the vendor's own
# bar delivery is discontinuous) rather than alerting on it. Running all day
# keeps that judgement in one place, and keeps the 09:30 ET open — the first
# moment a worker that died overnight becomes provable — covered without a
# second schedule.
OnCalendar=*:0/10
RandomizedDelaySec=1m
Persistent=false

[Install]
WantedBy=timers.target
