[Unit]
Description=ZeroGEX Market Tide snapshot refresh (every 5 min through the cash session)
Documentation=https://github.com/zerogex-options/zerogex-oa
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-oa

# Environment
Environment="PATH=/home/ubuntu/zerogex-oa/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/ubuntu/zerogex-oa/.env

# Compute the current cross-symbol Market Tide reading for every supported
# window and upsert one snapshot row per (window, 5-min bucket) so
# /api/flow/market-tide is a pure cache read.  The tool self-gates to the
# 09:30-16:10 ET cash session (weekends/holidays included), so this fires
# every 5 min but only does real work during the regular session and freezes
# the final row at the 16:00 ET close.  No ExecStartPost healthcheck: an
# out-of-session run legitimately no-ops, so "snapshot is recent" is not a
# post-condition of every fire (use `make market-tide-snapshot-healthcheck`
# for on-demand verification instead).
ExecStart=/usr/bin/make -C /home/ubuntu/zerogex-oa market-tide-refresh

# One anchor x 4 windows over indexed reads runs in a few seconds; cap low so
# a stuck DB never sits between 5-minute slots.
TimeoutStartSec=180

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/zerogex-oa

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-oa-market-tide-refresh
