[Unit]
Description=ZeroGEX Ingestion Engine
Documentation=https://github.com/zerogex-options/zerogex-oa
After=network-online.target
Wants=network-online.target

# Operator hook for active alerting (e.g. PagerDuty, Slack, email).
# Wired to zerogex-alert@%n.service, which takes the failed unit name
# as %i and dispatches to whatever backend is configured in
# /etc/zerogex/alert.env (slack | sns | pagerduty | webhook | stderr).
# Without alert.env the dispatcher falls back to stderr — alerts still
# land in the alert unit's own journal so the wiring is verifiable.
# Fires when the watchdog escalation in main_engine.py exits nonzero
# (stuck stale underlying) or when systemd's StartLimit fires.
OnFailure=zerogex-alert@%n.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/zerogex-oa

# Environment
Environment="PATH=/home/ubuntu/zerogex-oa/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/ubuntu/zerogex-oa/.env

# Execution
ExecStart=/home/ubuntu/zerogex-oa/venv/bin/python -m src.ingestion.main_engine
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy
Restart=always
RestartSec=10
StartLimitBurst=5
StartLimitInterval=300

# Process management
KillMode=mixed
KillSignal=SIGTERM
# 30 s was too tight: the in-memory bar buffers + DB pool teardown
# regularly need >30 s during graceful shutdown, which led to SIGKILL
# (see 2026-06-28 02:35:31 stop-sigterm timeout under the weekly
# VACUUM FULL).  60 s lets the flush path actually finish.
TimeoutStopSec=60
SendSIGKILL=yes

# Resource limits
MemoryMax=2G
# 1.5 of the box's 8 cores, shared by one worker per symbol plus the VIX/VXN
# and futures feeds. Each worker reprocesses its chain as fast as its share
# allows, so the unit sits pinned at this quota all session; that is its normal
# state. What the quota sets is how often each contract's option row is
# rewritten, and with it how many rows reach the database a second.
#
# 300% was committed on 2026-10-28 (6adda93), when 1.5 cores meant passes of
# 17-19 s for SPY and QQQ and 36-39 s for SPX and NDX, but it never reached the
# box, and the same day the live price stopped waiting on passes (c3687f0).
# Measured at 150% on 2026-11-06 at 14:43 ET with 5 symbols (make
# capacity-check): throttled in 99% of periods, yet the median option row was
# 4-18 s old, GEX published every minute, the price moved every second and no
# analytics cycle overran. Twice the quota would write option rows about twice
# as often into a database already averaging about 15 active sessions. So the
# MAG 7 stocks share this quota, and the capacity check's option row age says
# when it needs to grow (docs/runbooks/mag7_rollout.md).
CPUQuota=150%
CPUWeight=100

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/zerogex-oa

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-oa-ingestion

[Install]
WantedBy=multi-user.target
