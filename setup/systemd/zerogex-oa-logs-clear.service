[Unit]
Description=ZeroGEX nightly cleanup (logs + apt/snap/npm + build caches)
Documentation=https://github.com/zerogex-options/zerogex-oa
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/ubuntu/zerogex-oa

# Cleanup logic lives in the Makefile so operators can invoke each phase
# identically by hand and via this timer.  Running as root makes the `sudo`
# calls inside the recipes no-ops, which is fine — we want the elevated privs
# anyway to truncate files in /var/log, reload nginx/rsyslog, and clear the
# system apt/snap caches.
#
# Two sequential phases (Type=oneshot runs ExecStart lines in order; a
# failure stops the rest, so the most important — log truncation — goes first):
#   1. logs-clear-noconfirm  — journals + /var/log + nginx   (`make logs-clear`)
#   2. disk-clean-noconfirm  — apt/snap/npm + build caches    (`make disk-clean`)
# Each recipe guards its externals (command -v) and swallows per-tool errors
# (|| true), so a missing tool or absent path can't fail the nightly run.
ExecStart=/usr/bin/make logs-clear-noconfirm
ExecStart=/usr/bin/make disk-clean-noconfirm

# Safety: don't hold the system in degraded state if cleanup hangs (e.g.
# journalctl --rotate stuck on a corrupt journal, or apt waiting on a lock).
# Bumped from 600s when the apt/snap disk-clean phase was added.
TimeoutStartSec=900

StandardOutput=journal
StandardError=journal
SyslogIdentifier=zerogex-oa-logs-clear
